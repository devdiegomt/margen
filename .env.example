# Copiar a .env.local para desarrollo, o configura en Vercel → Settings → Environment Variables.
# Vite lee estas variables en build: tras cambiarlas en Vercel, hay que redesplegar.
# Sin ellas la app funciona en modo 100% local (sin sync, sin IA, sin notificaciones).

# Supabase → Settings → Data API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=TU-PUBLISHABLE-KEY

# Clave pública VAPID para notificaciones push.
# La privada va como secreto de la Edge Function (VAPID_KEYS), nunca aquí.
VITE_VAPID_PUBLIC_KEY=TU-CLAVE-PUBLICA-VAPID
